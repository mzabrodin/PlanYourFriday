# Copy to .env (git-ignored) and adjust if needed: cp .env.example .env

# PostgreSQL
POSTGRES_DB=planyourfriday
POSTGRES_USER=planyourfriday
POSTGRES_PASSWORD=planyourfriday
POSTGRES_PORT=5432

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Whole app in containers (docker compose up -d --build)
APP_PORT=8080
# Development keeps the test sign-in form when no Google keys are set; Production needs them
APP_ENVIRONMENT=Development

# Google OAuth client: the same values as in user-secrets (containers cannot read user-secrets).
# Empty = test sign-in form. Redirect URIs for Docker: http://localhost:8080/api/auth/signin-google
# and http://localhost:8080/api/calendar-connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email. Empty = everything lands in Mailpit (http://localhost:8025).
# For a real server set HOST, PORT and ENABLE_SSL together, e.g. Gmail with an app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_ENABLE_SSL=true
#   SMTP_USERNAME=<you>@gmail.com  SMTP_PASSWORD=<16-char app password>  SMTP_FROM=PlanYourFriday <<you>@gmail.com>
SMTP_HOST=
SMTP_PORT=
SMTP_ENABLE_SSL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
