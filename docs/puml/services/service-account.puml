@startuml service-account
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
hide empty members
left to right direction
skinparam nodesep 20
skinparam ranksep 50

package "Api" {
  class AuthController {
    +LoginWithGoogle(returnUrl, tz) : Challenge
    +GetMe() : UserView
    +Logout() : void
    +LogoutEverywhere() : void
  }

  class MeController {
    +UpdateProfile(request) : UserView
    +GetSettings() : UserSettingsView
    +UpdateSettings(request) : UserSettingsView
    +RegenerateFriendCode() : FriendCodeView
    +Export() : AccountExport
    +Delete() : void
  }

  class CurrentUser {
    +UserId : Guid
  }
}

package "Application" {
  class AccountService {
    +GetAsync() : User
    +GetProfileAsync() : UserView
    +UpdateProfileAsync(displayName, username, timeZone) : UserView
    +GetSettingsAsync() : UserSettingsView
    +UpdateSettingsAsync(settings) : UserSettingsView
    +RegenerateFriendCodeAsync() : FriendCodeView
    +ExportAsync() : AccountExport
    +DeleteAsync() : void
    +EndAllSessionsAsync() : void
  }

  interface ICurrentUser {
    +UserId : Guid
  }

  interface IUserRepository {
    +GetByIdAsync(id) : User?
    +IsUsernameTakenAsync(username, exceptUserId) : bool
    +Remove(user) : void
  }

  interface IGroupRepository {
    +ListOrganizedByAsync(userId) : List<Group>
    +Remove(group) : void
  }

  interface IEventRepository {
    +ListByGroupAsync(groupId) : List<Event>
  }

  interface IAccountQueries {
    +ExportAsync(userId) : AccountExport?
  }

  interface IOutbox {
    +Add(message) : void
  }

  interface IUnitOfWork {
    +SaveChangesAsync() : int
  }
}

package "Infrastructure" {
  class UserRepository
  class GroupRepository
  class EventRepository
  class AccountQueries
  class OutboxWriter
  class AppDbContext
}

AuthController --> AccountService
MeController --> AccountService
CurrentUser ..|> ICurrentUser

AccountService --> ICurrentUser
AccountService --> IUserRepository
AccountService --> IGroupRepository
AccountService --> IEventRepository
AccountService --> IAccountQueries
AccountService --> IOutbox : CalendarEventRemovalRequested
AccountService --> IUnitOfWork

IUserRepository <|.. UserRepository
IGroupRepository <|.. GroupRepository
IEventRepository <|.. EventRepository
IAccountQueries <|.. AccountQueries
IOutbox <|.. OutboxWriter
IUnitOfWork <|.. AppDbContext

@enduml
